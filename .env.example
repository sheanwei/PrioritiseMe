# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- LLM (OpenCode Zen, chat-completions API) ---
OPENCODE_API_KEY=
# Chat-completions endpoint as published by https://opencode.ai/zen/v1/models
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Main model: ask card, intake suggestion, solution sketch.
# Must be a chat-completions model (deepseek-*, glm-*, kimi-*, minimax-*, mistral-*, qwen3.8-max).
OPENCODE_MODEL=deepseek-v4.1-flash
# Cheaper model for email classification (defaults to OPENCODE_MODEL)
OPENCODE_MODEL_CHEAP=glm-5.3-flash
# Extra JSON merged into every request body. Disabling thinking cut intake analysis
# from ~10-14s to ~3-4s with the same decisions (measured 2026-11-20).
OPENCODE_EXTRA_BODY={"thinking": {"type": "disabled"}}

# --- Modes ---
# real | fake   (fake = deterministic, offline; used by tests)
TASKBOT_LLM=real
# mcp | fake    (fake = reads tests/fixtures/mail/*.json)
TASKBOT_MAIL=mcp
# Command that launches the Outlook MCP server over stdio (S4).
# --read-only makes the server itself drop write tools (defence in depth on top of the allowlist).
# Sign-in runs this same command with --login appended (device code shown on the dashboard).
TASKBOT_MAIL_MCP_COMMAND=npx -y @softeria/ms-365-mcp-server --preset mail --read-only
# Comma-separated MCP tool names TaskBot may call (FR-41). Anything else is refused before
# it is sent. Only list-/get-/search-/read-/verify- names are accepted.
TASKBOT_MAIL_TOOL_ALLOWLIST=verify-login,list-mail-folder-messages,list-mail-messages,get-mail-message,read-mail-text,list-mail-folders
# Mail folder polled every 5 minutes (well-known name or folder id) and how many newest messages per poll
TASKBOT_MAIL_FOLDER=inbox
TASKBOT_MAIL_FETCH_LIMIT=25
# Give up on one MCP sync after this many seconds (first run downloads the server via npx)
TASKBOT_MAIL_TIMEOUT_SECONDS=180
# Optional: your own Entra app registration if the tenant blocks the default one (PRD §8)
# MS365_MCP_CLIENT_ID=

# --- App ---
TASKBOT_PORT=8765
TASKBOT_DB=./taskbot.db
# on | off  (background jobs; tests turn this off)
TASKBOT_SCHEDULER=on
# 1 = log LLM prompts/responses
TASKBOT_DEBUG=0
